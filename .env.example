# ============================================
#  AMD AI Assistant - 环境变量模板
# ============================================
#  使用方法：
#  1. cp .env.example .env
#  2. 填入你的真实 API key
#  3. .env 文件已被 gitignore，不会提交到 GitHub
# ============================================

# ===== DeepSeek (主对话 LLM) =====
# 注册：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ===== OpenAI 格式 =====
# 注册：https://platform.openai.com
# base_url 支持三种填法（自动识别）：
#   https://api.openai.com/v1
#   https://xxx/v1/chat/completions
#   https://xxx/v1/responses   （Responses API）
OPENAI_API_KEY=sk-your-openai-key

# ===== Anthropic 格式 =====
# 注册：https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ===== 智谱 GLM =====
# 注册：https://open.bigmodel.cn
ZHIPU_API_KEY=your-zhipu-key

# ===== 第三方自定义 =====
# protocol 可选：openai / anthropic / anthropic-arch
# base_url 填法与对应格式一致
CUSTOM_API_KEY=sk-your-custom-key

# ===== 应用配置 =====
APP_ENV=development
APP_LOG_LEVEL=INFO
